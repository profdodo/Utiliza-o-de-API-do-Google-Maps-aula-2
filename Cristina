3. script.js
// Seleciona a caixa pelo ID
const caixa = document.getElementById("caixa");

// Seleciona os botões
const botaoCor = document.getElementById("cor");

const botaoGirar = document.getElementById("girar");

const botaoAumentar = document.getElementById("aumentar");

const botaoMover = document.getElementById("mover");

const botaoResetar = document.getElementById("resetar");


// Botão para mudar a cor
botaoCor.addEventListener("click", function() {

    caixa.classList.toggle("mudar-cor");

});


// Botão para girar
botaoGirar.addEventListener("click", function() {

    caixa.classList.toggle("girar");

});


// Botão para aumentar
botaoAumentar.addEventListener("click", function() {

    caixa.classList.toggle("aumentar");

});


// Botão para mover
botaoMover.addEventListener("click", function() {

    caixa.classList.toggle("mover");

});


// Botão para resetar todas as animações
botaoResetar.addEventListener("click", function() {

    caixa.classList.remove("mudar-cor");

    caixa.classList.remove("girar");

    caixa.classList.remove("aumentar");

    caixa.classList.remove("mover");

});
